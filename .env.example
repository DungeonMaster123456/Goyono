# ---- Database (Neon) ----
# Get this from your Neon project dashboard → Connection Details → Pooled connection
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/goyono?sslmode=require"
# Neon also gives a "direct" (non-pooled) URL — Prisma migrations need this one
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/goyono?sslmode=require"

# ---- NextAuth ----
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"
# Your deployed URL in production, http://localhost:3000 in dev
NEXTAUTH_URL="http://localhost:3000"

# ---- Google OAuth ----
# From Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
GOOGLE_CLIENT_ID="xxxxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="xxxxxxxx"

# ---- Groq (AI tutor, gpt-oss-120b) ----
# IMPORTANT: rotate any key that was ever pasted into a chat, doc, or ticket.
# Set this ONLY in Render's environment variables — never commit it to a file.
GROQ_API_KEY="gsk_xxxxxxxxxxxxxxxxxxxxxxxx"

# ---- Piston (code execution service) ----
# The URL of your self-hosted Piston instance (see /piston-service in this repo)
PISTON_URL="https://goyono-piston.onrender.com"
